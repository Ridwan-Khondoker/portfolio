# Copy to .env for local development. Never commit real values.

# PostgreSQL connection string (on Railway: ${{Postgres.DATABASE_URL}}).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance"

# Public URL of the app. Used for the CSRF origin check, cookie security and invite links.
APP_URL="https://automatedfinance.ridwankhondoker.dev"

# At least 32 random characters. Signs nothing visible but derives the key that encrypts 2FA secrets at rest:
# changing it later means every user must re-enroll 2FA. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Email of the first admin. At first start (and with `npm run seed:admin`) an invite link for it is printed to the logs.
ADMIN_EMAIL=""

# Optional: Google service account JSON (raw JSON or base64) for Sheets auto-sync. Share each sheet with its
# client_email as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Optional: send invite/reset links by email through Resend. Without these, admins copy the link instead.
RESEND_API_KEY=""
MAIL_FROM="Automated Finance <finance@example.com>"

# Optional: comma-separated IPs or IPv4 CIDR ranges allowed to reach the app at all (e.g. office IPs).
IP_ALLOWLIST=""

# Optional, local only: where the confidential build kit lives for `npm run seed` and the acceptance tests.
# DATA_DIR="./data"
# WORKBOOK_PATH="./source-workbooks/ORIGINAL_Google_Sheet_export.xlsx"
