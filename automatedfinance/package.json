{
  "name": "automatedfinance",
  "version": "1.0.0",
  "private": true,
  "description": "Private, invite-only finance dashboard for TRIBE LLC (automatedfinance.ridwankhondoker.dev).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start -H 0.0.0.0 -p ${PORT:-8080}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security": "next build && vitest run tests/security",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed": "tsx scripts/seed.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "sync:tick": "tsx scripts/sync-tick.ts",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.19.3",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "chart.js": "^4.6.1",
    "decimal.js": "^10.6.0",
    "google-auth-library": "^11.3.3",
    "next": "16.4.5",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
