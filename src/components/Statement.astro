---
import { Image } from 'astro:assets';
import { shot } from '../lib/data';
import { stats } from '../data/site';

const htd = shot('htd');
const stax = shot('stax-army');
---
<section class="section statement" data-section-theme="dark" aria-label="Introduction">
  <div class="wrap">
    <p class="label">Mission brief</p>
    <p class="text" data-words>
      {stats.pmYears} years running projects and marketing, {stats.devYears} writing the code. I lead development at
      <span class="chip">
        {htd && <Image src={htd} alt="" width={240} />}
        <small>New Jersey — Laravel rebuild</small>
      </span>
      Happy to Deliver and delivery at Tribe Marketing, building the
      <em>platform</em>, then running the <em>team</em> that ships it — from courier apps to
      <span class="chip">
        {stax && <Image src={stax} alt="" width={240} />}
        <small>Stax Army — site, social & ads</small>
      </span>
      brand launches and campaigns.
    </p>
  </div>
</section>

<style>
  .statement .label { margin-bottom: 28px; }
  .text {
    margin: 0; font: 600 clamp(30px, 4.6vw, 68px)/1.08 var(--font-display); letter-spacing: -.03em; max-width: 22ch;
  }
  .text em { font-style: normal; color: var(--accent-text); }
  /* inline screenshot "chips", like the photos set into the copy on the reference site */
  .chip { display: inline-grid; vertical-align: middle; gap: 4px; margin: 0 .12em; transform: translateY(-.06em); }
  .chip :global(img) { width: clamp(90px, 9vw, 150px); height: clamp(52px, 5.2vw, 86px); object-fit: cover; object-position: top; border-radius: 6px; }
  .chip small { font: 400 11px/1.2 var(--font-mono); letter-spacing: 0; color: var(--muted); max-width: 16ch; }
  :global(.w) { opacity: .16; transition: opacity .2s linear; }
  @media (prefers-reduced-motion: reduce) { :global(.w) { opacity: 1; } }
</style>

<script>
  import { gsap, reduceMotion } from '../scripts/motion/core';

  // Split the copy into words (chips stay whole) and light them up in reading order as the section scrolls.
  const el = document.querySelector<HTMLElement>('[data-words]');
  if (el && !reduceMotion) {
    const walk = (node: Node) => {
      for (const child of Array.from(node.childNodes)) {
        if (child.nodeType === Node.TEXT_NODE) {
          const frag = document.createDocumentFragment();
          child.textContent!.split(/(\s+)/).forEach((part) => {
            if (!part) return;
            if (/^\s+$/.test(part)) { frag.append(part); return; }
            const s = document.createElement('span');
            s.className = 'w';
            s.textContent = part;
            frag.append(s);
          });
          child.replaceWith(frag);
        } else if (child instanceof HTMLElement && child.classList.contains('chip')) {
          child.classList.add('w');
        } else {
          walk(child);
        }
      }
    };
    walk(el);
    gsap.to(el.querySelectorAll('.w'), {
      opacity: 1, stagger: 0.1, ease: 'none',
      scrollTrigger: { trigger: el, start: 'top 80%', end: 'bottom 45%', scrub: true },
    });
  }
</script>
