---
const tracks = [
  {
    id: 'build-track',
    top: 'Build',
    bottom: 'Software',
    role: 'Software engineer / developer',
    text: 'Architecture, data models and the hard parts of the code — Laravel and Vue platforms, integrations with the systems clients already run, and admin tools their teams can operate.',
    points: ['Laravel · Vue · Filament · MySQL', 'Property-system integrations', 'Auth, access control, notifications'],
    href: '/work#development',
    cta: 'Engineering work',
  },
  {
    id: 'manage-track',
    top: 'Manage',
    bottom: 'Projects',
    role: 'Project manager',
    text: 'Scope, budget and a distributed team across five countries — plus the marketing side: sites, social media and ad campaigns that bring in reach and revenue.',
    points: ['Delivery across 5 countries', 'Websites, social & paid ads', 'Coaching and client communication'],
    href: '/work#management',
    cta: 'Management work',
  },
];
---
<section id="build" class="section build" data-section-theme="light" aria-label="What I do">
  <div class="wrap">
    <p class="label">Two tracks, one person</p>
    {tracks.map((t, i) => (
      <article class="trk" aria-labelledby={t.id}>
        <h2 id={t.id} class="h-xl split" data-split>
          <span class="a">{t.top}</span>
          <span class="b">{t.bottom}</span>
        </h2>
        <div class="body">
          <p class="role">{t.role}</p>
          <p class="lede">{t.text}</p>
          <ul>{t.points.map((p) => <li>{p}</li>)}</ul>
          <a class="btn" href={t.href}>{t.cta} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .build .label { margin-bottom: 40px; }
  .trk { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 380px); gap: clamp(28px, 4vw, 64px); align-items: end; padding: clamp(40px, 6vh, 72px) 0; border-top: 1px solid var(--line); }
  .split { display: grid; font-size: clamp(56px, 8.4vw, 150px); }
  .split .b { color: var(--accent-text); padding-left: .35em; }
  .trk:nth-of-type(2) .split .a { padding-left: .35em; }
  .trk:nth-of-type(2) .split .b { padding-left: 0; }
  .body { display: grid; gap: 16px; padding-bottom: .6em; }
  .role { margin: 0; font: 600 clamp(20px, 1.8vw, 26px)/1.2 var(--font-display); }
  .body .lede { margin: 0; }
  .body ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font: 400 14px/1.4 var(--font-mono); }
  .body li::before { content: '+ '; color: var(--gold-text); }
  .body .btn { width: fit-content; margin-top: 8px; }
  @media (max-width: 860px) {
    .trk { grid-template-columns: 1fr; }
    .split .b, .trk:nth-of-type(2) .split .a { padding-left: .25em; }
  }
</style>

<script>
  import { gsap } from '../scripts/motion/core';

  // The two halves of each heading start pulled apart and close up as the heading scrolls into place.
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    document.querySelectorAll<HTMLElement>('[data-split]').forEach((h) => {
      const tl = gsap.timeline({ scrollTrigger: { trigger: h, start: 'top 95%', end: 'top 35%', scrub: 0.6 } });
      tl.from(h.querySelector('.a'), { xPercent: -18, ease: 'none' }, 0)
        .from(h.querySelector('.b'), { xPercent: 18, ease: 'none' }, 0);
    });
  });
</script>
