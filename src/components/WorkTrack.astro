---
import Shot from './Shot.astro';
import { getDevProjects, getClients, host } from '../lib/data';

const [flagship] = await getDevProjects();
const clients = (await getClients()).slice(0, 5);

const items = [
  {
    href: `/work/${flagship.id}`,
    slug: flagship.data.shot,
    name: flagship.data.title,
    caption: `${flagship.data.place} — ${flagship.data.role}`,
    track: 'Engineering',
    domain: host(flagship.data.url),
  },
  ...clients.map((c) => ({
    href: `/work#${c.id}`,
    slug: c.id,
    name: c.data.name,
    caption: c.data.scope.split(',')[0].replace(/\.$/, ''),
    track: 'Management',
    domain: host(c.data.url),
  })),
];
---
<section id="featured" class="featured" data-section-theme="dark" aria-labelledby="featured-title">
  <div class="pin" data-track-pin>
    <header class="intro">
      <p class="label">Featured work</p>
      <h2 id="featured-title" class="h-xl"><span>Shipped</span><span class="accent">& live</span></h2>
      <p class="lede">A platform I lead end to end, and the brands whose sites, social and campaigns I run.</p>
      <a class="btn" href="/work">All work <span class="arrow" aria-hidden="true">→</span></a>
    </header>
    <div class="viewport">
    <ol class="track" data-track>
      {items.map((it, i) => (
        <li class="card">
          <a href={it.href}>
            <div class="frame">
              <Shot slug={it.slug} name={it.name} domain={it.domain} eager={i < 2} sizes="(max-width: 860px) 80vw, 38vw" />
            </div>
            <div class="meta">
              <span class="track-tag">{it.track}</span>
              <h3>{it.name}</h3>
              <p>{it.caption}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>
    </div>
  </div>
</section>

<style>
  .featured { position: relative; }
  .pin {
    min-height: 100vh; display: flex; align-items: center; gap: clamp(40px, 5vw, 96px);
    padding: calc(var(--header-h) + 24px) 0 48px var(--gutter); overflow: hidden;
  }
  .intro { flex: 0 0 clamp(320px, 32vw, 460px); display: grid; gap: 22px; align-content: center; }
  .intro .h-xl { display: grid; font-size: clamp(48px, 5.6vw, 96px); }
  .intro .accent { color: var(--accent-text); }
  .intro .lede { margin: 0; }
  .intro .btn { width: fit-content; }

  /* cards slide out from under the intro column rather than over it */
  .viewport { flex: 1; min-width: 0; overflow: hidden; }
  .track { display: flex; gap: clamp(20px, 2.4vw, 40px); list-style: none; margin: 0; padding: 0 var(--gutter) 0 0; will-change: transform; }
  .card { flex: 0 0 clamp(300px, 38vw, 620px); }
  .card a { display: grid; gap: 16px; text-decoration: none; color: inherit; }
  .frame { aspect-ratio: 16 / 10; overflow: hidden; border: 1px solid var(--line); position: relative; }
  .frame :global(.shot) { transition: transform .9s var(--ease); }
  .card a:hover .frame :global(.shot), .card a:focus-visible .frame :global(.shot) { transform: scale(1.04); }
  /* a violet frame sweeps in on hover */
  .frame::after {
    content: ''; position: absolute; inset: 0; border: 2px solid var(--violet); box-shadow: inset 0 0 24px rgba(176, 38, 255, .4);
    clip-path: inset(0 100% 0 0); transition: clip-path .6s var(--ease-in-out); pointer-events: none;
  }
  .card a:hover .frame::after, .card a:focus-visible .frame::after { clip-path: inset(0 0 0 0); }
  .meta { display: grid; gap: 4px; }
  .track-tag { font: 400 12px/1 var(--font-mono); color: var(--gold-text); }
  .meta h3 { font-size: clamp(22px, 2vw, 30px); }
  .meta p { margin: 0; color: var(--muted); font: 400 14px/1.4 var(--font-mono); }

  @media (max-width: 860px) {
    .pin { display: block; min-height: 0; padding: clamp(96px, 14vh, 140px) 0 64px; }
    .intro { padding: 0 var(--gutter); margin-bottom: 40px; }
    /* touch: native swipe with snap instead of a pinned scroll */
    .viewport { overflow: visible; }
    .track { overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 var(--gutter) 12px; scrollbar-width: none; }
    .track::-webkit-scrollbar { display: none; }
    .card { flex-basis: 80vw; scroll-snap-align: start; }
  }
</style>

<script>
  import { gsap } from '../scripts/motion/core';

  const pin = document.querySelector<HTMLElement>('[data-track-pin]');
  const track = document.querySelector<HTMLElement>('[data-track]');
  const viewport = track?.parentElement;
  if (pin && track && viewport) {
    gsap.matchMedia().add('(min-width: 861px) and (prefers-reduced-motion: no-preference)', () => {
      const distance = () => Math.max(0, track.scrollWidth - viewport.clientWidth);
      gsap.to(track, {
        x: () => -distance(), ease: 'none',
        scrollTrigger: {
          trigger: pin, start: 'top top', end: () => `+=${distance()}`,
          pin: true, scrub: 0.8, invalidateOnRefresh: true, anticipatePin: 1,
        },
      });
    });
  }
</script>
