---
---
<div class="preloader" aria-hidden="true" data-preloader>
  <div class="boot">
    <p class="big"><span>Boot</span> <span class="who">Ridwan</span></p>
    <div class="bar"><i data-bar></i></div>
    <ol class="log">
      <li data-step="fonts"><span>Typefaces</span><b>…</b></li>
      <li data-step="model"><span>Robot model</span><b data-pct>0%</b></li>
      <li data-step="scene"><span>Systems</span><b>…</b></li>
    </ol>
  </div>
  <i class="scan" data-scan></i>
</div>

<style>
  /* white boot screen: same paper tone as the hero it hands over to */
  .preloader {
    position: fixed; inset: 0; z-index: 150; background: #f4f1f8; color: #0b0712;
    display: grid; place-items: center; padding: var(--gutter);
  }
  :global(html:not(.intro-pending)) .preloader { display: none; }
  .boot { width: min(560px, 100%); }
  .big { margin: 0 0 22px; font: 800 clamp(44px, 8vw, 96px)/1 var(--font-name); letter-spacing: .02em; }
  .big .who { color: #8a00e6; }
  .bar { height: 2px; background: #d6cce4; margin-bottom: 18px; }
  .bar i { display: block; height: 100%; width: 0; background: var(--violet); }
  .log { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font: 400 14px/1.4 var(--font-mono); color: #5e5470; }
  .log li { display: flex; justify-content: space-between; gap: 16px; opacity: 0; transform: translateY(6px); transition: opacity .35s, transform .35s var(--ease); }
  .log li[data-active], .log li[data-done] { opacity: 1; transform: none; }
  .log li[data-done] b { color: #7200bf; }
  .log b { font-weight: 400; }
  .scan { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--violet); box-shadow: 0 0 14px 1px rgba(176, 38, 255, .6); opacity: 0; }
</style>

<script>
  import { gsap, reduceMotion } from '../scripts/motion/core';

  // The boot log runs as a readable sequence: each line stays on screen for a minimum time,
  // the model percentage counts up smoothly (never faster than the real download), and the
  // screen only wipes away once the robot scene has actually started.
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('[data-preloader]')!;
  const bot = document.querySelector<HTMLElement>('.hero spline-viewer');
  const bar = el.querySelector<HTMLElement>('[data-bar]')!;
  const pct = el.querySelector<HTMLElement>('[data-pct]')!;
  const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
  const step = (name: string, state: 'active' | 'done', text?: string) => {
    const li = el.querySelector<HTMLElement>(`[data-step="${name}"]`)!;
    li.toggleAttribute('data-active', state === 'active');
    li.toggleAttribute('data-done', state === 'done');
    if (text) li.querySelector('b')!.textContent = text;
  };
  const progress = (p: number) => { bar.style.width = `${Math.round(p * 100)}%`; };

  // Once the wipe starts, the robot zooms out on its own; the text and nav follow after it settles.
  const revealUI = () => root.classList.remove('intro-pending');
  let exited = false;
  function exit(fast = false) {
    if (exited) return;
    exited = true;
    const scan = el.querySelector<HTMLElement>('[data-scan]')!;
    const d = fast ? .5 : 1.1;
    gsap.timeline({ onComplete: () => { el.remove(); } })
      .set(scan, { opacity: 1 })
      .to(scan, { top: '100%', duration: d, ease: 'power2.inOut' }, 0)
      .to(el, { clipPath: 'inset(100% 0 0 0)', duration: d, ease: 'power2.inOut' }, 0);
    setTimeout(revealUI, 2000);
  }

  // Downloads the scene, reporting real progress; returns a blob URL so the viewer doesn't fetch it again.
  async function download(src: string, onProgress: (f: number) => void) {
    const res = await fetch(src);
    const total = Number(res.headers.get('content-length')) || 0;
    const reader = res.body?.getReader();
    if (!reader || !total) {
      const blob = await res.blob();
      onProgress(1);
      return URL.createObjectURL(blob);
    }
    const chunks: Uint8Array<ArrayBuffer>[] = [];
    let got = 0;
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      chunks.push(value);
      got += value.length;
      onProgress(got / total);
    }
    return URL.createObjectURL(new Blob(chunks));
  }

  // Counts the displayed percentage up to the real one at no more than 100% per `minMs`.
  function countUp(real: () => number, minMs: number) {
    return new Promise<void>((resolve) => {
      let shown = 0, last = performance.now();
      const tick = (now: number) => {
        shown = Math.min(real(), shown + (now - last) / minMs);
        last = now;
        pct.textContent = `${Math.round(shown * 100)}%`;
        progress(.2 + shown * .6);
        if (shown >= 1) resolve(); else requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }

  async function boot() {
    const src = bot?.dataset.src;
    if (!bot || !src) return;
    if (reduceMotion) return; // no robot, no boot sequence

    // A repeat visit in the same session skips the log, not the robot's entrance.
    let seen = false;
    try { seen = sessionStorage.getItem('booted') === '1'; } catch { /* storage blocked: show the full boot */ }
    if (seen) el.style.visibility = 'hidden';
    setTimeout(() => exit(true), 12000); // slow network or no WebGL: never trap the visitor here

    const loaded = new Promise<void>((r) => bot.addEventListener('load-complete', () => r(), { once: true }));
    let real = 0;
    const scene = download(src, (f) => { real = f; }).catch(() => src);

    if (!seen) {
      step('fonts', 'active');
      await Promise.all([document.fonts.ready, wait(900)]);
      step('fonts', 'done', 'ok');
      progress(.2);

      step('model', 'active');
      await Promise.all([scene, countUp(() => real, 1600)]);
      step('model', 'done', 'ok');
    }

    bot.setAttribute('url', await scene);
    if (!seen) {
      step('scene', 'active');
      await Promise.all([loaded, wait(900)]);
      step('scene', 'done', 'online');
      progress(1);
      await wait(700); // let "online" land before the wipe
    } else {
      await loaded;
    }
    try { sessionStorage.setItem('booted', '1'); } catch { /* ignore */ }
    exit(seen);
  }
  boot();
</script>
