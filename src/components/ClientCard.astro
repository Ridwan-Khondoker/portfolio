---
import type { CollectionEntry } from 'astro:content';
import Shot from './Shot.astro';
import { shot, host } from '../lib/data';

interface Props { client: CollectionEntry<'clients'> }
const { client } = Astro.props;
const { name, url, scope, result } = client.data;
const domain = host(url);
const hasShot = !!shot(client.id, 'desktop');
const hasMobile = !!shot(client.id, 'mobile');

// Monogram for the placeholder mark: first letter of the first two words, or the first two
// letters of a one-word name.
const words = name.split(/\s+/).filter(Boolean);
const initials = (words.length > 1 ? words[0][0] + words[1][0] : name.slice(0, 2)).toUpperCase();

// Short service tag for the corner tab, read from the scope text (nothing invented).
const s = scope.toLowerCase();
const tags = [
  /website|site\b/.test(s) && 'Web',
  /social/.test(s) && 'Social',
  /\bads?\b|campaign/.test(s) && 'Ads',
  /community|membership/.test(s) && 'Community',
].filter(Boolean).slice(0, 3);
---
<article class="client" id={client.id}>
  <div class="frame">
    <button class="face" type="button" aria-label={`${name}: show ${hasMobile ? 'mobile view' : 'scope'}`} aria-pressed="false" data-reveal>
      <div class="base">
        <span class="glow" aria-hidden="true"></span>
        {hasShot ? (
          <div class="window"><Shot slug={client.id} name={name} domain={domain} sizes="(max-width: 640px) 80vw, (max-width: 1080px) 40vw, 26vw" /></div>
        ) : (
          <div class="mark" role="img" aria-label={`${name} logo coming soon`}>
            <span class="initials">{initials}</span>
            <span class="soon">Logo coming soon</span>
          </div>
        )}
      </div>
      <div class="over" aria-hidden="true">
        {hasMobile ? (
          <div class="phone"><Shot slug={client.id} view="mobile" name={name} sizes="200px" /></div>
        ) : (
          <p class="scope-big">{scope}</p>
        )}
      </div>
    </button>
    <!-- the notched corner tab (like a season/year tag): services + name -->
    <div class="tab">
      {tags.length > 0 && <span class="tags">{tags.join(' · ')}</span>}
      <h3>{name}</h3>
    </div>
  </div>
  <div class="meta">
    {domain ? <a href={url} target="_blank" rel="noopener">{domain} <span aria-hidden="true">↗</span></a> : <span class="pending">Link coming soon</span>}
    {hasMobile && <p>{scope}</p>}
    {result && <p class="result">{result}</p>}
  </div>
</article>

<style>
  .client { --r: 18px; display: grid; gap: 14px; }
  .frame {
    position: relative; aspect-ratio: 1 / 1; border: 1px solid var(--edge); border-radius: var(--r);
    transition: border-color .35s var(--ease);
  }
  .frame:hover, .frame:focus-within { --edge: var(--edge-hot); }

  .face {
    position: absolute; inset: 0; display: block; width: 100%; height: 100%; padding: 0; border: 0; border-radius: calc(var(--r) - 1px);
    background: none; color: inherit; cursor: pointer; overflow: hidden;
  }
  .face:focus-visible { outline: 2px solid var(--accent); outline-offset: -6px; }
  .base { position: absolute; inset: 0; display: grid; place-items: center; padding: 12% 10% 22%; }

  /* soft violet glow behind the item: a blurred solid circle, no gradient */
  .glow {
    position: absolute; left: 50%; top: 42%; width: 46%; aspect-ratio: 1; border-radius: 50%;
    background: var(--violet); opacity: .16; filter: blur(48px); transform: translate(-50%, -50%) scale(.9);
    transition: opacity .5s var(--ease), transform .7s var(--ease);
  }
  .face:hover .glow, .face:focus-visible .glow { opacity: .3; transform: translate(-50%, -50%) scale(1.1); }

  .mark { position: relative; display: grid; justify-items: center; gap: 14px; }
  .initials { font: 800 clamp(64px, 8vw, 128px)/.9 var(--font-name); letter-spacing: .02em; color: var(--fg); transition: transform .7s var(--ease); }
  .face:hover .initials { transform: scale(1.06); }
  .soon { font: 400 12px/1 var(--font-mono); color: var(--muted); }

  .window {
    position: relative; width: 100%; aspect-ratio: 16 / 10; border: 1px solid var(--edge); border-radius: 10px; overflow: hidden;
    box-shadow: 0 24px 50px -24px rgba(0, 0, 0, .6); transition: transform .7s var(--ease);
  }
  .face:hover .window { transform: translateY(-4px) scale(1.02); }

  /* hover / tap reveal wipes up from the bottom */
  .over {
    position: absolute; inset: 0; display: grid; place-items: center; align-content: start; padding: 28px 26px 30%;
    background: var(--surface); color: var(--fg);
    clip-path: inset(100% 0 0 0); transition: clip-path .7s var(--ease-in-out);
  }
  .over:has(.phone) { grid-template-rows: minmax(0, 1fr); align-content: stretch; padding: 20px 20px 24%; }
  .face:hover .over, .face:focus-visible .over, .face[aria-pressed='true'] .over { clip-path: inset(0 0 0 0); }
  .phone { height: 100%; max-height: 100%; aspect-ratio: 390 / 844; border: 6px solid #1c1526; border-radius: 22px; overflow: hidden; box-shadow: 0 0 0 1px var(--violet), 0 0 28px rgba(176, 38, 255, .35); }
  .phone :global(.shot) { object-position: top; }
  .scope-big { margin: 0; font: 600 clamp(18px, 1.6vw, 24px)/1.25 var(--font-display); text-align: left; justify-self: start; }

  /* Corner tab. It sits over the frame's bottom-right corner in the page colour, drawing its own
     top and left edges; the two pseudo-elements are the concave joins back into the frame. */
  .tab {
    position: absolute; right: -1px; bottom: -1px; z-index: 2; max-width: 78%;
    display: grid; gap: 6px; padding: 14px 20px 16px 20px;
    background: var(--bg); border-top: 1px solid var(--edge); border-left: 1px solid var(--edge); border-top-left-radius: var(--r);
    transition: background-color .7s var(--ease), border-color .35s var(--ease);
    pointer-events: none;
  }
  .tab::before, .tab::after {
    content: ''; position: absolute; width: var(--r); height: var(--r);
    border-right: 1px solid var(--edge); border-bottom: 1px solid var(--edge); border-bottom-right-radius: var(--r);
    box-shadow: calc(var(--r) / 2) calc(var(--r) / 2) 0 calc(var(--r) / 2) var(--bg);
    transition: box-shadow .7s var(--ease), border-color .35s var(--ease);
  }
  .tab::before { right: 0; bottom: 100%; }
  .tab::after { right: 100%; bottom: 0; }
  .tags { font: 400 12px/1 var(--font-mono); color: var(--muted); white-space: nowrap; }
  .tab h3 { font: 700 clamp(17px, 1.5vw, 22px)/1.1 var(--font-display); letter-spacing: -.01em; color: var(--gold-text); }

  .meta { display: grid; gap: 4px; padding-left: 4px; }
  .meta a, .pending { font: 400 13px/1.4 var(--font-mono); color: var(--accent-text); width: fit-content; }
  .pending { color: var(--muted); }
  .meta p { margin: 4px 0 0; color: var(--muted); font-size: 15px; }
  .meta .result { margin: 4px 0 0; font-size: 15px; color: var(--gold-text); }
</style>
