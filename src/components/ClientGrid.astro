---
import ClientCard from './ClientCard.astro';
import { getClients } from '../lib/data';

interface Props { heading?: boolean; theme?: 'dark' | 'light' | 'gold' }
const { heading = true, theme = 'dark' } = Astro.props;
const clients = await getClients();
---
<section class="section roster" data-section-theme={theme} aria-labelledby={heading ? 'roster-title' : undefined} aria-label={heading ? undefined : 'Clients'}>
  <div class="wrap">
    {heading && (
      <header class="head">
        <h2 id="roster-title" class="h-l">Client roster</h2>
        <p class="lede">Websites, social media and ad campaigns — built, launched and run for reach and revenue.</p>
      </header>
    )}
    <div class="grid">
      {clients.map((c) => <ClientCard client={c} />)}
    </div>
  </div>
</section>

<style>
  .head { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: end; margin-bottom: clamp(40px, 6vh, 72px); }
  .head .lede { margin: 0; }
  /* card outline: neutral grey like a showcase grid, violet on hover */
  .roster { --edge: #2e2e33; --edge-hot: var(--violet); }
  :global(html[data-theme='light']) .roster { --edge: #cfc8d8; --edge-hot: var(--accent); }
  /* staggered columns: the middle column (every other one on two columns) sits lower */
  .grid {
    --stagger: clamp(48px, 7vw, 120px);
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; gap: clamp(28px, 3vw, 48px) clamp(16px, 2vw, 28px);
    padding-bottom: var(--stagger);
  }
  .grid > :global(:nth-child(3n + 2)) { transform: translateY(var(--stagger)); }
  @media (max-width: 1080px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid > :global(:nth-child(3n + 2)) { transform: none; }
    .grid > :global(:nth-child(2n)) { transform: translateY(var(--stagger)); }
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; padding-bottom: 0; }
    .grid > :global(:nth-child(2n)) { transform: none; }
    .head { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Touch has no hover: a tap toggles the reveal instead.
  document.querySelectorAll<HTMLButtonElement>('[data-reveal]').forEach((b) => {
    b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')));
  });
</script>
