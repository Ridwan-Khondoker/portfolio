---
const offices = [
  { country: 'United States', hq: true, lon: -74.17, desc: 'Headquarters: client operations, field teams and day-to-day platform users.', cities: 'Newark, NJ · Chicago, IL · Austin, TX' },
  { country: 'Bangladesh', lon: 90.41, desc: 'Project management, design and front-end.', cities: 'Dhaka' },
  { country: 'India', lon: 77.59, desc: 'Engineering: platform development and backend delivery.', cities: 'Bengaluru · Hyderabad · Noida' },
  { country: 'Philippines', lon: 120.98, desc: 'Operations and support: round-the-clock coverage.', cities: 'Manila · Cebu · Davao' },
  { country: 'Slovakia', lon: 17.11, desc: 'European delivery: QA and front-end support.', cities: 'Bratislava · Košice' },
];
---
<section class="section globe" data-section-theme="dark" aria-labelledby="globe-title">
  <div class="wrap">
    <h2 id="globe-title" class="h-l">Where the work happens</h2>
    <p class="lede">A team across five countries and a dozen cities, so something is always moving on your project. Hover a country to spin the globe to it.</p>
    <div class="globe-wrap">
      <div class="globe-stage"><canvas id="globe" role="img" aria-label="Rotating globe marking offices in the United States, Bangladesh, India, the Philippines and Slovakia"></canvas></div>
      <ul class="offices">
        {offices.map((o) => (
          <li class:list={{ hq: o.hq }} data-lon={o.lon} tabindex="0">
            <i class="pin" aria-hidden="true"></i>
            <div><span class="city">{o.country}</span><span class="desc">{o.desc}</span><span class="cities">{o.cities}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .globe .lede { margin: 20px 0 0; }
  .globe-wrap { display: grid; grid-template-columns: 1fr 380px; gap: clamp(24px, 4vw, 56px); align-items: center; margin-top: 36px; }
  .globe-stage { position: relative; aspect-ratio: 1; max-width: 620px; width: 100%; margin: 0 auto; }
  #globe { width: 100%; height: 100%; display: block; }
  .offices { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .offices li { padding: 16px 0; border-bottom: 1px solid var(--line); display: flex; gap: 14px; align-items: flex-start; cursor: default; outline-offset: 4px; }
  .pin { width: 9px; height: 9px; margin-top: 7px; border-radius: 50%; background: var(--violet); box-shadow: 0 0 10px var(--violet); flex: none; }
  .hq .pin { background: var(--gold); box-shadow: 0 0 10px var(--gold); }
  .city { font: 600 17px/1.3 var(--font-display); display: block; }
  .desc { font-size: 14px; color: var(--muted); }
  .cities { display: block; font: 400 12px/1.4 var(--font-mono); color: var(--muted); margin-top: 6px; }
  .offices li:hover .city, .offices li:focus-visible .city { color: var(--violet-hi); }
  @media (max-width: 1080px) { .globe-wrap { grid-template-columns: 1fr; } }
</style>

<script>
  import { initGlobe } from '../scripts/globe.js';
  initGlobe();
</script>
