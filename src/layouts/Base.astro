---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Home runs the boot intro: everything but the robot stays hidden until it settles. */
  intro?: boolean;
  /** Theme of the first section, so the first paint already has the right background. */
  theme?: 'dark' | 'light' | 'gold';
}
const {
  title = 'Ridwan Khondoker — Software engineer & project manager',
  description = 'Ridwan Khondoker builds web platforms and runs the teams that ship them.',
  intro = false,
  theme = 'dark',
} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {intro && (
      <script is:inline>
        // Set before first paint so nothing flashes in and back out; the preloader removes it.
        // Only the first visit in a session boots: coming back shows the page straight away.
        var booted = false;
        try { booted = sessionStorage.getItem('booted') === '1'; } catch (e) { /* blocked: full intro */ }
        if (!booted && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('intro-pending');
          setTimeout(function () { document.documentElement.classList.remove('intro-pending'); }, 14000);
        }
      </script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { startLenis, getLenis, ScrollTrigger } from '../scripts/motion/core';
      import { initThemeSwitch } from '../scripts/motion/theme';
      import { initMenu } from '../scripts/menu';
      startLenis();
      initThemeSwitch();
      initMenu();

      // Back/forward returns to the same spot. The browser's own restore lands before the pinned
      // sections have measured themselves, so the offset is saved on leave and re-applied once
      // the layout has settled.
      const key = `scroll:${location.pathname}`;
      history.scrollRestoration = 'manual';
      addEventListener('pagehide', () => { try { sessionStorage.setItem(key, String(Math.round(scrollY))); } catch { /* ignore */ } });
      const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      if (nav?.type === 'back_forward') {
        let y = 0;
        try { y = Number(sessionStorage.getItem(key)) || 0; } catch { /* ignore */ }
        const restore = () => {
          ScrollTrigger.refresh();
          const lenis = getLenis();
          if (lenis) lenis.scrollTo(y, { immediate: true, force: true }); else scrollTo(0, y);
        };
        if (document.readyState === 'complete') requestAnimationFrame(restore);
        else addEventListener('load', () => requestAnimationFrame(restore), { once: true });
      }
      // restored whole from the back-forward cache: nothing replays, just re-measure
      addEventListener('pageshow', (e) => { if (e.persisted) ScrollTrigger.refresh(); });
    </script>
  </body>
</html>

<style is:global>
  /* intro: only the hero robot is visible until the preloader hands over */
  html.intro-pending .site-header,
  html.intro-pending main > :not(.hero, .preloader),
  html.intro-pending .site-footer,
  html.intro-pending .hero-ui {
    opacity: 0;
    visibility: hidden;
  }
  .site-header, main > :not(.preloader), .site-footer, .hero-ui {
    transition: opacity .9s var(--ease) .15s, visibility 0s;
  }
</style>
